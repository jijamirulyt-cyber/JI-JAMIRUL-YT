rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidMedia(maxBytes) {
      return request.resource.size <= maxBytes &&
             (request.resource.contentType.matches('image/.*') ||
              request.resource.contentType.matches('video/.*') ||
              request.resource.contentType.matches('audio/.*'));
    }

    match /users/{userId}/media/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidMedia(50 * 1024 * 1024);
    }

    match /chats/{conversationId}/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidMedia(25 * 1024 * 1024);
    }
  }
}
